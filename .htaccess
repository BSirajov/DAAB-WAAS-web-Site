# Apache redirects for renamed sponsorship page (enable mod_rewrite)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^daab-private(/|$) - [F,L]
RewriteRule ^az/forum_2027_sponsorship\.html$ /az/sponsorship_partnership.html [R=301,L]
RewriteRule ^en/forum_2027_sponsorship\.html$ /en/sponsorship_partnership.html [R=301,L]
RewriteRule ^az/sponsors\.html$ /az/sponsorship_partnership.html [R=301,L]
RewriteRule ^en/sponsors\.html$ /en/sponsorship_partnership.html [R=301,L]
RewriteRule ^complex-topics\.html$ /az/complex-topics.html [R=301,L]
RewriteRule ^complex-topics-approach\.html$ /az/complex-topics-approach.html [R=301,L]
RewriteRule ^complex-topics-informatics\.html$ /az/complex-topics-informatics.html [R=301,L]
RewriteRule ^az/membership\.html$ /az/membership_value.html [R=301,L]
RewriteRule ^en/membership\.html$ /en/membership_value.html [R=301,L]
ErrorDocument 404 /404.html
# HTML documents and extensionless directory indexes (/, /az/, …).
# CSS, JS, and images are unchanged; pages already version those with ?v=.
RewriteRule \.html$ - [E=DAAB_HTML:1]
RewriteRule ^$ - [E=DAAB_HTML:1]
RewriteRule /$ - [E=DAAB_HTML:1]
</IfModule>

# Revalidate HTML on every visit so the next load uses the current page,
# including its versioned drawer CSS/JS. Does not apply to CSS, JS, or images.
<IfModule mod_headers.c>
<FilesMatch "\.(html|htm)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
Header set Cache-Control "no-cache, must-revalidate" env=DAAB_HTML
Header set Cache-Control "no-cache, must-revalidate" env=REDIRECT_DAAB_HTML
</IfModule>
